{
  "name": "hermit-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hermit \u2014 agentic SDLC pipeline for GitHub Copilot workspaces",
  "workspaces": [
    "packages/core",
    "packages/agents",
    "packages/mcp-shared",
    "packages/mcp-workflow",
    "packages/mcp-jira",
    "packages/mcp-confluence",
    "packages/mcp-sharepoint",
    "packages/mcp-figma",
    "packages/mcp-scm",
    "packages/cli"
  ],
  "scripts": {
    "test": "node scripts/smoke.mjs",
    "check:mcp": "node scripts/mcp-check.mjs",
    "check:gates": "node scripts/gate-check.mjs",
    "demo": "node scripts/demo.mjs",
    "check:monorepo": "node scripts/monorepo-check.mjs",
    "check:specialists": "node scripts/specialist-check.mjs",
    "check:harness": "node scripts/harness-check.mjs"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
